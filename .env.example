# ---------------------------------------------------------------------------
# browser-use-jev-bridge — copy to .env and fill in. NEVER commit the real .env.
#
# The bu-fast CLI loads ./.env at startup. A variable that is already set in
# the process environment always wins over the file. The library entry point
# (runTask) does NOT load .env implicitly — call applyDotEnv() yourself.
#
# No key is ever written to logs, audit records, doctor output or error
# messages; doctor reports each one only as "set" or "unset".
# ---------------------------------------------------------------------------

# --- Jev fast policy: TypeSafe structured-decision endpoint -----------------
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

# --- Jev fast policy: small OpenAI-compatible model used ONLY for field text -
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-chat
# none | low  (provider dependent)
TEXT_MODEL_REASONING=low

# --- Browser Use Pi fallback ------------------------------------------------
# Pi resolves models through its own catalog/providers.
OPENROUTER_API_KEY=
# Only needed when you use Browser.cloud(); the default here is local Chrome.
BROWSER_USE_API_KEY=
BUJB_PI_MODEL=openrouter/openai/gpt-5.6-luna
BUJB_PI_REASONING=medium

# --- Browser ----------------------------------------------------------------
# Attach Pi to an already-running Chrome (recommended on macOS):
#   /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
#     --remote-debugging-port=9222 --user-data-dir="$HOME/.bujb-chrome"
BUJB_CDP_URL=http://127.0.0.1:9222
# Or leave BUJB_CDP_URL empty and set BUJB_BROWSER=chromium to let Pi launch one.
BUJB_BROWSER=chrome
BUJB_CHROME_EXECUTABLE=

# --- Privacy / safety defaults (all default to the safe value) --------------
# Pi anonymous run counters. OFF unless you explicitly set this to 1.
BUJB_TELEMETRY=0
DO_NOT_TRACK=1
# Screen recording. OFF unless you explicitly set this to 1.
BUJB_RECORD=0

# --- Final verification thresholds -----------------------------------------
# A run is only reported "completed" when the verifier returns SATISFIED AND
# both of these are met. Raise them to make completion harder to claim.
BUJB_VERIFY_MIN_CONFIDENCE=0.80
BUJB_VERIFY_MIN_PROBABILITY=0.80

# --- Budget (one budget for the whole run, Jev steps + Pi steps) ------------
BUJB_MAX_STEPS=40
BUJB_TIMEOUT_MS=300000
BUJB_MAX_COST_USD=1

# --- MCP server (bu-fast-mcp) ----------------------------------------------
# Concurrent browser tasks. More than one means more than one Chrome profile.
BUJB_MCP_MAX_SESSIONS=1
# An approval nobody answers within this window is DENIED, never approved.
BUJB_MCP_APPROVAL_TIMEOUT_MS=300000
# How long a finished session stays readable before it is dropped.
BUJB_MCP_SESSION_TTL_MS=900000

# --- Deadline and cleanup ---------------------------------------------------
# Extra time allowed for closing the browser after the run budget expires.
BUJB_CLEANUP_MS=10000

# --- Named secrets ----------------------------------------------------------
# Secret VALUES are injected by name and are never generated by a model and
# never sent to the text helper. Define one variable per named secret:
#   BUJB_SECRET_<NAME>=value
#   BUJB_SECRET_DOMAINS_<NAME>=example.com,*.example.org
# BOTH variables are required. Browser Use Pi refuses a secret with no domain
# scope, so an unscoped secret is redacted from all output but never injected,
# and `doctor` reports it as unscoped rather than letting the run fail.
# Example:
# BUJB_SECRET_DEMO_PASSWORD=
# BUJB_SECRET_DOMAINS_DEMO_PASSWORD=example.com
