{
  "name": "browser-use-jev-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Hybrid browser tool: Jev-style fast policy in front of a single Browser Use Pi session, with independent verification, approval gating and audit logging.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.19" },
  "bin": { "bu-fast": "dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "skill", "docs", "README.md", "LICENSES"],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:test": "node -e \"require('node:fs').rmSync('.build-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test --test-concurrency=1 .build-test/tests/*.test.js",
    "test:unit": "npm run build:test && node --test --test-concurrency=1 .build-test/tests/unit.*.test.js",
    "test:fixtures": "npm run build:test && node --test --test-concurrency=1 .build-test/tests/integration.*.test.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "doctor": "npm run build && node dist/cli.js doctor --json"
  },
  "dependencies": {
    "@browser_use/pi": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
